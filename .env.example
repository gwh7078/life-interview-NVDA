DATABASE_PATH=./data/codex-worktree.db
# Unified local diagnostics root for runtime logs, realtime traces, captures and E2E artifacts.
DIAGNOSTICS_DIR=./runtime/diagnostics
# 0 = metadata-only snapshots. Set to 1 locally only when you need Transcript / Agent Memory / gaps for manual debugging.
DIAGNOSTICS_CAPTURE_CONTENT=0
# Raw Closeout request/model-output captures may contain transcript content and stay disabled unless explicitly requested.
# Relative capture names are written under DIAGNOSTICS_DIR/captures/closeout-real/.
# CLOSEOUT_SAVE_REQUEST_TO=request.json
# CLOSEOUT_SAVE_MODEL_OUTPUT_TO=model-output.json
HOST=127.0.0.1
PORT=4174
AUTH_MODE=demo_phone
TEST_STORY_ID=00000000-0000-4000-8000-000000000204
VOLCENGINE_API_KEY=
# Optional Seeduplex voice override; the default is zh_female_vv_jupiter_bigtts.
# To try this candidate, uncomment it; compatibility with Seeduplex 1.0 is unverified:
# DOUBAO_VOICE=zh_female_meilinvyou_uranus_bigtts
# Shared text-model runtime defaults for Closeout / Completion / Generation.
# For a loopback OpenAI-compatible local runtime, set for example:
# TEXT_MODEL_PROVIDER=openai-compatible
# TEXT_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# TEXT_MODEL=your-local-model
# TEXT_MODEL_API_KEY may stay empty for loopback runtimes.
TEXT_MODEL_PROVIDER=volcengine-agent-plan
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
TEXT_MODEL=deepseek-v4-flash
TEXT_MODEL_API_FORMAT=chat-completions
TEXT_MODEL_TIMEOUT_MS=60000

# Optional task-specific overrides. Existing CLOSEOUT_* configuration remains supported.
# CLOSEOUT_API_KEY=
# CLOSEOUT_BASE_URL=
# CLOSEOUT_MODEL=
# CLOSEOUT_TIMEOUT_MS=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=qwen-audio-3.0-realtime-plus
REALTIME_WRAPUP_MS=1080000
REALTIME_MAX_SESSION_MS=1200000
REALTIME_CLOSE_GRACE_MS=45000
# Opening is retried once if the provider creates no assistant response within this window. This is not VAD/turn-end timeout.
REALTIME_OPENING_RESPONSE_TIMEOUT_MS=8000
E2E_TTS_VOICE=Tingting

# NVIDIA Agent runtime.
# direct = existing Web direct-model path; stub = deterministic interface tests; agent = NemoClaw/OpenClaw.
AI_TASK_RUNTIME=direct
NEMOCLAW_SANDBOX=my-assistant
AGENT_PROVIDER=
# For the first real E2E, these profiles may all point to the same model; benchmark separately later.
AGENT_MODEL_DEFAULT=volcengine/deepseek-v4-flash
AGENT_MODEL_REASONING=
AGENT_MODEL_REASONING_FAST=
AGENT_MODEL_WRITING=
AGENT_TOOL_HOST=127.0.0.1
AGENT_TOOL_PORT=4175
# Private/reachable host URL for the sandbox Tool API, for example http://10.0.0.5:4175.
AGENT_TOOL_BASE_URL=
# At least 32 random bytes. Never commit the real value.
AGENT_TOOL_TOKEN_SECRET=
AGENT_RUNTIME_TIMEOUT_MS=120000
# Phase 1 smoke-only legacy model variable. Formal Phase 2B uses AGENT_MODEL_* above.
AGENT_MODEL=
AGENT_SMOKE_USER_ID=
AGENT_SMOKE_STORY_ID=
AGENT_TOOL_AUDIT_LOG=./runtime/diagnostics/agent-tools.jsonl

# Optional local AI services checked by scripts/check-ai-env.sh.
OPENCLAW_SANDBOX_URL=http://127.0.0.1:18790
NEMO_RETRIEVER_BASE_URL=http://127.0.0.1:7670
NEMO_RETRIEVER_MCP_URL=http://127.0.0.1:7670/mcp
NEMO_RETRIEVER_VECTORDB_URL=http://127.0.0.1:7671
NEMO_RETRIEVER_COLLECTION=life-interview-transcripts
# Only needed for remote NVIDIA embedding/inference setup; keep empty in the template.
NVIDIA_API_KEY=
NVIDIA_INFERENCE_API_KEY=

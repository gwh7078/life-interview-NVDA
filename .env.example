DATABASE_PATH=./data/codex-worktree.db
# Unified local diagnostics root for runtime logs, realtime traces, captures and E2E artifacts.
DIAGNOSTICS_DIR=./runtime/diagnostics
# 0 = metadata-only snapshots. Set to 1 locally only when you need Transcript / Agent Memory / gaps for manual debugging.
DIAGNOSTICS_CAPTURE_CONTENT=0
# Raw Closeout request/model-output captures may contain transcript content and stay disabled unless explicitly requested.
# Relative capture names are written under DIAGNOSTICS_DIR/captures/closeout-real/.
# CLOSEOUT_SAVE_REQUEST_TO=request.json
# CLOSEOUT_SAVE_MODEL_OUTPUT_TO=model-output.json
HOST=127.0.0.1
PORT=4174
# Keep local backend calls out of the system HTTP proxy.
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1
AUTH_MODE=demo_phone
TEST_STORY_ID=00000000-0000-4000-8000-000000000204
# Step-Audio-2-mini is the default. Set stepaudio3_quality to opt into StepAudio 3.
STORY_INTERVIEW_PROVIDER=stepaudio2_mini
STEPAUDIO3_REALTIME_MODEL=stepaudio-3-realtime-preview
# The second formal profile remains Step-Audio-2-mini on StepFun Cloud until a future Spark runtime is available.
STEPFUN_API_KEY=
STEPFUN_REALTIME_MODEL=step-audio-2-mini
# Optional A/B override: voice_tool or supervisor_auto. Defaults follow the Voice Profile.
# Deprecated backend_auto is accepted as an alias for supervisor_auto.
# REALTIME_MEMORY_TRIGGER=supervisor_auto
# Step-Audio-2-mini Coach; API key falls back to BAILIAN_API_KEY when unset.
REALTIME_COACH_PROVIDER=openai-compatible
REALTIME_COACH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REALTIME_COACH_MODEL=qwen3-8b
REALTIME_COACH_API_KEY=
REALTIME_COACH_GATE_TIMEOUT_MS=1200
REALTIME_COACH_TOTAL_TIMEOUT_MS=5000
# Optional experimental provider; not a default or automatic fallback.
MODELBEST_API_KEY=
MODELBEST_REALTIME_MODEL=MiniCPM-o-4.5-Realtime
REALTIME_LOCAL_SILENCE_TIMEOUT_MS=2000
# Shared text-model runtime defaults for Closeout / Completion / Generation.
# Current temporary cloud route: Alibaba Cloud Model Studio (Bailian).
# For a loopback OpenAI-compatible local runtime, set for example:
# TEXT_MODEL_PROVIDER=openai-compatible
# TEXT_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# TEXT_MODEL=your-local-model
# TEXT_MODEL_API_KEY may stay empty for loopback runtimes.
BAILIAN_API_KEY=
TEXT_MODEL_PROVIDER=openai-compatible
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3.6-35b-a3b
TEXT_MODEL_API_FORMAT=chat-completions
TEXT_MODEL_TIMEOUT_MS=120000

# To switch back to a local Spark runtime, replace the TEXT_MODEL_* values above.

# Optional task-specific overrides. Existing CLOSEOUT_* configuration remains supported.
# CLOSEOUT_API_KEY=
# CLOSEOUT_BASE_URL=
# CLOSEOUT_MODEL=
# CLOSEOUT_TIMEOUT_MS=
# macOS worktree setup syncs this from the login Keychain for Retriever and optional DashScope Realtime.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=qwen-audio-3.0-realtime-plus
REALTIME_WRAPUP_MS=1080000
REALTIME_MAX_SESSION_MS=1200000
REALTIME_CLOSE_GRACE_MS=45000
# Opening is retried once if the provider creates no assistant response within this window. This is not VAD/turn-end timeout.
REALTIME_OPENING_RESPONSE_TIMEOUT_MS=8000
# Slow recall deadline; a timed out recall must not block the live turn.
REALTIME_SLOW_DEADLINE_MS=5000
E2E_TTS_VOICE=Tingting

# NVIDIA Agent runtime.
# direct = existing Web direct-model path; stub = deterministic interface tests; agent = NemoClaw/OpenClaw.
AI_TASK_RUNTIME=direct
NEMOCLAW_SANDBOX=my-assistant
AGENT_PROVIDER=bailian
# Keep every Agent task profile on the single requested Qwen3.6 35B-A3B model.
AGENT_MODEL_DEFAULT=bailian/qwen3.6-35b-a3b
AGENT_MODEL_REASONING=bailian/qwen3.6-35b-a3b
AGENT_MODEL_REASONING_FAST=bailian/qwen3.6-35b-a3b
AGENT_MODEL_REALTIME_CONTEXT=bailian/qwen3.6-35b-a3b
AGENT_MODEL_WRITING=bailian/qwen3.6-35b-a3b
# Controls only the optional interview.context_hint Agent in the existing Current Story slow path.
# 1/true enables and 0 disables; when unset, an available Agent Task runtime enables it by default.
# This does not enable Retriever; direct-evidence fallback applies only when Retriever is active.
REALTIME_CONTEXT_AGENT_ENABLED=1
# Controls only allowlisted status messages sent through the competition WebSocket panel.
# It does not control the SSE Tech Observer, Agent execution, or Retriever/Pipeline.
COMPETITION_TECH_PANEL=0
# Optional OpenClaw thinking override. Leave empty to use the model default.
# AGENT_THINKING=off
# Optional metadata-only JSONL timing output for Agent Runtime performance analysis.
# It records phase timings and byte counts, never prompt or model-output content.
# AGENT_RUNTIME_DIAGNOSTICS_PATH=./runtime/diagnostics/agent-runtime-timing.jsonl
AGENT_TOOL_HOST=127.0.0.1
AGENT_TOOL_PORT=4175
# Private/reachable host URL for the sandbox Tool API, for example http://10.0.0.5:4175.
AGENT_TOOL_BASE_URL=
# At least 32 random bytes. Never commit the real value.
AGENT_TOOL_TOKEN_SECRET=
AGENT_RUNTIME_TIMEOUT_MS=120000
# Phase 1 smoke-only legacy model variable. Formal Phase 2B uses AGENT_MODEL_* above.
AGENT_MODEL=
AGENT_SMOKE_USER_ID=
AGENT_SMOKE_STORY_ID=
AGENT_TOOL_AUDIT_LOG=./runtime/diagnostics/agent-tools.jsonl

# Optional local AI services checked by scripts/check-ai-env.sh.
OPENCLAW_SANDBOX_URL=http://127.0.0.1:18790
NEMO_RETRIEVER_BASE_URL=http://127.0.0.1:7670
NEMO_RETRIEVER_MCP_URL=http://127.0.0.1:7670/mcp
NEMO_RETRIEVER_VECTORDB_URL=http://127.0.0.1:7671
NEMO_RETRIEVER_COLLECTION=life-interview-transcripts
# Enables the Retriever client and Current Story retrieval pipeline; independent of Agent and panel flags.
# Set true only after the local Retriever health/ingest/query smoke passes.
NEMO_RETRIEVER_ENABLED=true
NEMO_RETRIEVER_API_TOKEN=
NEMO_RETRIEVER_TIMEOUT_MS=30000
# Separate public background index. It never shares the Transcript collection.
NEMO_ERA_CONTEXT_COLLECTION=life-interview-era-context-v1
NEMO_ERA_CONTEXT_ENABLED=false
# URL reachable from the NemoClaw sandbox for the scoped memory-search script.
# Do not use 127.0.0.1 here when the script runs inside the sandbox.
AGENT_RETRIEVAL_BASE_URL=
# Separate short-lived retrieval token secret; AGENT_TOOL_TOKEN_SECRET is accepted as a local fallback.
AGENT_RETRIEVAL_TOKEN_SECRET=
# Only needed for remote NVIDIA embedding/inference setup; keep empty in the template.
NVIDIA_API_KEY=
NVIDIA_INFERENCE_API_KEY=

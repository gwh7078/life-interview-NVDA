            "content": "## \u9ad8\u8003\u524d\u591c\n\n\u4e00\u4e5d\u516b\u4e09\u5e74\u4e03\u6708\u5341\u56db\u65e5\uff0c\u8392\u53bf\u3002\n\n\u90a3\u5929\u591c\u91cc\u6211\u7a81\u7136\u53d1\u8d77\u70e7\u6765\uff0c\u8111\u5b50\u660f\u660f\u6c89\u6c89\u7684\uff0c\u6d51\u8eab\u53d1\u51b7\u3002\u660e\u660e\u660e\u5929\u5c31\u662f\u9ad8\u8003\u7684\u65e5\u5b50\uff0c\u6211\u8eba\u5728\u5e8a\u4e0a\u7ffb\u6765\u8986\u53bb\uff0c\u5fc3\u91cc\u5168\u662f\u4e00\u7247\u614c\u4e71\u3002\u73ed\u4e3b\u4efb\u517c\u5316\u5b66\u8001\u5e08\u738b\u660e\u6668\u5f97\u77e5\u6d88\u606f\u540e\uff0c\u8fde\u591c\u628a\u6211\u9001\u53bb\u4e86\u533b\u9662\u3002\u6253\u4e0a\u8f93\u6db2\u7684\u65f6\u5019\u5df2\u7ecf\u662f\u540e\u534a\u591c\u4e86\uff0c\u70b9\u6ef4\u4e00\u6ef4\u6ef4\u843d\u8fdb\u8840\u7ba1\u91cc\uff0c\u6211\u76ef\u7740\u5929\u82b1\u677f\u4e0a\u7684\u88c2\u7f1d\uff0c\u6574\u665a\u51e0\u4e4e\u6ca1\u6709\u5408\u773c\u3002\n\n\u7b2c\u4e8c\u5929\u6e05\u6668\uff0c\u5934\u75db\u8fd8\u5728\u6301\u7eed\uff0c\u8eab\u4f53\u865a\u8f6f\u65e0\u529b\uff0c\u4f46\u6211\u8fd8\u662f\u6309\u65f6\u8d70\u8fdb\u4e86\u8003\u573a\u3002\n\n\u8003\u5377\u53d1\u4e0b\u6765\uff0c\u6211\u54ac\u7740\u7b14\u6746\u5b50\u4e00\u9053\u4e00\u4f5c\u7b54\u3002\u73b0\u5728\u60f3\u6765\uff0c\u90a3\u6bb5\u8bb0\u5fc6\u5df2\u7ecf\u6a21\u7cca\u5f97\u62fc\u51d1\u4e0d\u51fa\u7ec6\u8282\u2014\u2014\u662f\u54ea\u9053\u9898\u5361\u4f4f\u4e86\u6211\uff0c\u54ea\u9053\u9898\u5199\u5f97\u987a\u624b\uff0c\u90fd\u5df2\u7ecf\u8bf4\u4e0d\u6e05\u4e86\u3002\u552f\u4e00\u8bb0\u5f97\u6e05\u695a\u7684\u662f\u5206\u6570\u51fa\u6765\u7684\u90a3\u4e00\u5929\uff1a\u603b\u5206486\uff0c\u672c\u79d1\u7ebf450\uff0c\u8d85\u8fc7\u4e86\uff0c\u64e6\u7740\u8fb9\u513f\u8fc7\u53bb\u4e86\u3002\u5355\u79d1\u6210\u7ee9\u91cc\uff0c\u5316\u5b6699.5\u5206\uff0c\u8bed\u658758\u5206\u3002\u8fd9\u4e2a\u5dee\u8ddd\uff0c\u8ba9\u6211\u540e\u6765\u60f3\u8d77\u9ad8\u8003\u4e24\u4e2a\u5b57\u7684\u65f6\u5019\uff0c\u603b\u89c9\u5f97\u547d\u8fd0\u5f00\u4e86\u4e00\u4e2a\u6709\u70b9\u5947\u602a\u7684\u73a9\u7b11\u3002\n\n\u586b\u62a5\u5fd7\u613f\u4e3b\u8981\u542c\u4e86\u8001\u5e08\u7684\u5efa\u8bae\u3002\u56e0\u4e3a\u5316\u5b66\u6210\u7ee9\u7a81\u51fa\uff0c\u6211\u88ab\u5f55\u5165\u4e86\u5c71\u4e1c\u5efa\u7b51\u6750\u6599\u5de5\u4e1a\u5b66\u9662\u7684\u7845\u9178\u76d0\u4e13\u4e1a\u3002\u62ff\u5230\u5f55\u53d6\u901a\u77e5\u4e66\u7684\u90a3\u6bb5\u65f6\u95f4\uff0c\u6211\u53ea\u77e5\u9053\u8fd9\u4e2a\u4e13\u4e1a\u548c\u6c34\u6ce5\u5236\u9020\u6709\u5173\uff0c\u5176\u4ed6\u7684\u4ec0\u4e48\u90fd\u4e0d\u61c2\u3002\n\n## \u4ece\u5acc\u5f03\u5230\u8ba4\u540c\n\n\u521a\u8fdb\u5927\u5b66\u7684\u65f6\u5019\uff0c\u6211\u5bf9\u7845\u9178\u76d0\u4e13\u4e1a\u662f\u771f\u7684\u4e0d\u559c\u6b22\u3002\n\n\u5728\u6211\u60f3\u8c61\u91cc\uff0c\u6c34\u6ce5\u5c31\u662f\u7070\u6251\u6251\u7684\u4e1c\u897f\uff0c\u8ddf\u6ce5\u571f\u6ca1\u4ec0\u4e48\u4e24\u6837\uff0c\u6709\u4ec0\u4e48\u503c\u5f97\u5b66\u7684\uff1f\u6bcf\u5929\u6253\u4ea4\u9053\u90fd\u662f\u7c89\u5c18\u548c\u6405\u62cc\u673a\uff0c\u8fd9\u6837\u7684\u672a\u6765\u8ba9\u6211\u611f\u5230\u8ff7\u832b\u548c\u5931\u843d\u3002\n\n\u4f46\u6539\u53d8\u53d1\u751f\u5728\u5927\u4e8c\u4e4b\u524d\u7684\u4e00\u6b21\u65b0\u751f\u53c2\u89c2\u6d3b\u52a8\u4e0a\u3002\u5b66\u6821\u7ec4\u7ec7\u6211\u4eec\u53bb\u4e86\u5de5\u5382\uff0c\u6211\u7b2c\u4e00\u6b21\u770b\u5230\u4e86\u771f\u6b63\u7684\u6c34\u6ce5\u751f\u4ea7\u7ebf\u3002\u9ad8\u5927\u7684\u7a91\u7089\u77d7\u7acb\u5728\u773c\u524d\uff0c\u8f70\u9e23\u7684\u8bbe\u5907\u8fd0\u8f6c\u4e0d\u505c\uff0c\u771f\u5b9e\u7684\u751f\u4ea7\u6d41\u7a0b\u5c31\u5728\u6211\u9762\u524d\u5c55\u5f00\u3002\u90a3\u4e00\u523b\uff0c\u5fc3\u91cc\u7684\u5931\u843d\u611f\u6d88\u9000\u4e86\u4e00\u5927\u534a\u3002\u539f\u6765\u8fd9\u4e2a\u4e13\u4e1a\u4e0d\u662f\u6211\u60f3\u50cf\u4e2d\u7684\u90a3\u6837\u7b80\u5355\u7c97\u964b\uff0c\u5b83\u6709\u5b83\u7684\u89c4\u6a21\uff0c\u6709\u5b83\u7684\u6280\u672f\u542b\u91cf\u3002\n\n\u540e\u6765\uff0c\u901a\u8fc7\u8001\u5e08\u7684\u62a5\u544a\u3001\u8bfe\u5802\u4e0a\u7684\u8bb2\u89e3\u3001\u4e0e\u540c\u5b66\u7684\u8ba8\u8bba\u548c\u4e13\u4e1a\u5c55\u89c8\uff0c\u6211\u4e00\u70b9\u4e00\u70b9\u5730\u7406\u89e3\u4e86\u7845\u9178\u76d0\u7684\u4e16\u754c\u3002\u6211\u77e5\u9053\u4e86\u6c34\u6ce5\u4e0d\u53ea\u662f\"\u548c\u4e00\u5305\u6ce5\u52a0\u6c34\u5012\u5728\u5730\u4e0a\"\u90a3\u4e48\u7b80\u5355\uff0c\u80cc\u540e\u662f\u590d\u6742\u7684\u5316\u5b66\u53cd\u5e94\u3001\u7cbe\u786e\u7684\u6e29\u5ea6\u63a7\u5236\u3001\u4e25\u5bc6\u7684\u5de5\u827a\u53c2\u6570\u3002\u6211\u4e0d\u518d\u6392\u65a5\u5b83\uff0c\u800c\u662f\u5f00\u59cb\u8ba4\u540c\u5b83\u3002\n\n\u8fd9\u6bb5\u7ecf\u5386\u7ed9\u6211\u7559\u4e0b\u7684\u5370\u8c61\u8fdc\u6bd4\u77e5\u8bc6\u672c\u8eab\u66f4\u6df1\uff1a\u5bf9\u4e00\u4ef6\u4e8b\u7269\u7684\u5224\u65ad\uff0c\u4e0d\u80fd\u505c\u7559\u5728\u8868\u9762\u3002\u4f60\u53ea\u6709\u8d70\u8fdb\u53bb\u770b\u4e00\u770b\uff0c\u624d\u80fd\u77e5\u9053\u5b83\u5230\u5e95\u662f\u4ec0\u4e48\u6837\u5b50\u3002\n\n## \u6cad\u6cb3\u7684\u6c34\n\n1980\u5e74\u52301983\u5e74\uff0c\u6211\u5728\u8392\u53bf\u4e00\u4e2d\u4f4f\u6821\u3002\u6bcf\u5468\u672b\u6211\u4f1a\u6b65\u884c\u56de\u5bb6\u3002\u590f\u5929\u6c5b\u671f\u7684\u65f6\u5019\uff0c\u6cad\u6cb3\u7684\u6c34\u4f4d\u4e0a\u6da8\uff0c\u4f1a\u6f2b\u8fc7\u6751\u53e3\u90a3\u5ea7\u5c0f\u6c34\u6ce5\u6865\u3002\n\n\u6709\u4e00\u6b21\u548c\u540c\u5b66\u7ed3\u4f34\u56de\u5bb6\uff0c\u8d70\u5230\u6cb3\u8fb9\u65f6\u6c34\u5df2\u7ecf\u9f50\u8170\u6df1\u4e86\u3002\u6cb3\u6c34\u6e4d\u6025\uff0c\u5927\u5bb6\u53ea\u597d\u4e92\u76f8\u6400\u6276\u3001\u624b\u62c9\u624b\u5730\u5f80\u524d\u632a\u6b65\u3002\u884c\u674e\u88ab\u6211\u4eec\u4e3e\u8fc7\u5934\u9876\uff0c\u751f\u6015\u6d78\u6e7f\u4e86\u3002\u811a\u5e95\u4e0b\u662f\u6ed1\u817b\u7684\u77f3\u5934\u548c\u88ab\u6c34\u51b2\u52a8\u7684\u6c99\u77f3\uff0c\u6bcf\u4e00\u6b65\u90fd\u8e29\u5f97\u5f88\u5403\u529b\u3002\u56de\u5934\u770b\u8eab\u540e\uff0c\u6cb3\u5cb8\u5728\u8fdc\u5904\u6726\u80e7\u7740\uff0c\u6765\u65f6\u7684\u8def\u5df2\u7ecf\u88ab\u6c34\u541e\u6ca1\u4e86\u3002\n\n\u5230\u4e86\u5bf9\u5cb8\u4e4b\u540e\uff0c\u51e0\u4e2a\u4eba\u90fd\u677e\u4e86\u4e00\u53e3\u6c14\u3002\u73b0\u5728\u56de\u60f3\u8d77\u6765\uff0c\u90a3\u6bb5\u7ecf\u5386\u4ecd\u7136\u662f\u60ca\u9669\u7684\u3002\u5982\u679c\u5f53\u65f6\u6ca1\u6709\u5f7c\u6b64\u6400\u6276\uff0c\u540e\u679c\u53ef\u80fd\u4e0d\u582a\u8bbe\u60f3\u3002\u5f88\u591a\u5177\u4f53\u7684\u4e1c\u897f\u6211\u5df2\u7ecf\u8bb0\u4e0d\u6e05\u4e86\u2014\u2014\u540c\u884c\u4e86\u51e0\u4e2a\u540c\u5b66\uff0c\u5929\u6c14\u5982\u4f55\uff0c\u6cb3\u9762\u6709\u591a\u5bbd\uff0c\u6c34\u6d41\u7684\u901f\u5ea6\u5230\u5e95\u600e\u6837\u2014\u2014\u4f46\u5b83\u4eec\u4e0d\u91cd\u8981\u3002\u91cd\u8981\u7684\u662f\uff0c\u90a3\u4e9b\u6c34\u6f2b\u8fc7\u8170\u95f4\u7684\u611f\u89c9\uff0c\u8fd8\u6709\u540c\u5b66\u4eec\u7684\u624b\u62c9\u5728\u4e00\u8d77\u7684\u6e29\u5ea6\uff0c\u4e00\u76f4\u7559\u5728\u8bb0\u5fc6\u91cc\u3002\n\n## \u75c5\u623f\u7684\u7eff\u519b\u88c5\n\n\u5927\u4e8c\u90a3\u5e74\uff0c\u6211\u56e0\u4e3a\u5341\u4e8c\u6307\u80a0\u7403\u90e8\u6e83\u75a1\u4f4f\u9662\u4e86\u4e00\u6bb5\u65f6\u95f4\u3002\u751f\u75c5\u8ba9\u8eab\u4f53\u7684\u72b6\u6001\u8dcc\u5230\u8c37\u5e95\uff0c\u4e5f\u8ba9\u6211\u548c\u5468\u56f4\u7684\u4eba\u4ea7\u751f\u4e86\u65b0\u7684\u4ea4\u96c6\u3002\n\n\u75c5\u623f\u91cc\u4f4f\u7740\u4e24\u4f4d\u5e74\u8f7b\u7684\u89e3\u653e\u519b\u6218\u58eb\uff0c\u4e5f\u662f\u751f\u75c5\u4f4f\u9662\u7684\u3002\u6211\u4eec\u5f88\u5feb\u6210\u4e86\u670b\u53cb\uff0c\u804a\u5929\u3001\u6253\u724c\uff0c\u65e5\u5b50\u8fc7\u5f97\u6bd4\u60f3\u8c61\u4e2d\u5feb\u3002\u5206\u522b\u7684\u65f6\u5019\uff0c\u4ed6\u4eec\u4e00\u4eba\u9001\u4e86\u6211\u4e00\u5957\u7eff\u519b\u88c5\u3002\u8863\u670d\u53e0\u5f97\u6574\u6574\u9f50\u9f50\u653e\u5728\u624b\u91cc\uff0c\u539a\u5b9e\u3001\u7c97\u7cd9\u3001\u5e26\u7740\u519b\u961f\u7279\u6709\u7684\u6c14\u606f\u3002\u90a3\u4e24\u5957\u519b\u88c5\u6211\u4e00\u76f4\u4fdd\u5b58\u7740\uff0c\u5b83\u4eec\u4e0d\u8d35\u91cd\uff0c\u5374\u662f\u6211\u5927\u5b66\u65f6\u671f\u6700\u73cd\u8d35\u7684\u7eaa\u5ff5\u54c1\u4e4b\u4e00\u3002\n\n\u4e24\u4f4d\u6218\u58eb\u53eb\u4ec0\u4e48\u540d\u5b57\uff0c\u6211\u73b0\u5728\u8bb0\u4e0d\u6e05\u4e86\u3002\u4f46\u8fd9\u4e0d\u5f71\u54cd\u8fd9\u6bb5\u7ecf\u5386\u7684\u4ef7\u503c\u3002\u5728\u90a3\u4e2a\u5e74\u7eaa\uff0c\u4e00\u6bb5\u7eaf\u7cb9\u7684\u53cb\u8c0a\u3001\u51e0\u4ef6\u6734\u7d20\u7684\u793c\u7269\uff0c\u5c31\u80fd\u8ba9\u4eba\u8bb0\u4f4f\u5f88\u4e45\u3002\n\n## \u5b9e\u4e60\uff1a\u5180\u4e1c\u6c34\u6ce5\u5382\n\n\u5927\u5b66\u6bd5\u4e1a\u524d\uff0c\u5b66\u6821\u5b89\u6392\u6211\u4eec\u53bb\u5180\u4e1c\u6c34\u6ce5\u5382\u5b9e\u4e60\u3002\u8fd9\u662f\u6211\u4ece\u5b66\u751f\u8d70\u5411\u793e\u4f1a\u4e4b\u95f4\u7684\u6700\u540e\u4e00\u8bfe\u3002\n\n\u5728\u5b66\u6821\u91cc\u5b66\u4e86\u90a3\u4e48\u4e45\u7684\u7845\u9178\u76d0\u7406\u8bba\uff0c\u7ec8\u4e8e\u6709\u673a\u4f1a\u770b\u5230\u5b83\u843d\u5728\u4e00\u4e2a\u5927\u578b\u6c34\u6ce5\u5382\u7684\u8fd0\u8f6c\u5168\u8c8c\u3002\u751f\u4ea7\u7ebf\u7684\u89c4\u6a21\u8fdc\u8d85\u4e4b\u524d\u53c2\u89c2\u8fc7\u7684\u90a3\u4e9b\u5382\u5b50\uff0c\u5de5\u827a\u73af\u8282\u4e5f\u66f4\u52a0\u590d\u6742\u548c\u5b8c\u5584\u3002\u5e08\u5085\u4eec\u624b\u628a\u624b\u5730\u6559\uff0c\u628a\u8bfe\u672c\u4e0a\u7684\u516c\u5f0f\u4e00\u6761\u6761\u5bf9\u5e94\u5230\u5b9e\u9645\u7684\u8bbe\u5907\u4e0a\u9762\u3002\n\n\u5b9e\u4e60\u7ed3\u675f\u65f6\uff0c\u6211\u77e5\u9053\u81ea\u5df1\u5df2\u7ecf\u51c6\u5907\u597d\u4e86\u3002\u7845\u9178\u76d0\u4e13\u4e1a\u4ece\u6700\u521d\u88ab\u6211\u5acc\u5f03\u7684\"\u6c34\u6ce5\u4e13\u4e1a\"\uff0c\u53d8\u6210\u4e86\u6211\u80fd\u5b89\u8eab\u7acb\u547d\u7684\u4e13\u4e1a\u3002\u8fd9\u6761\u8def\u8d70\u5f97\u6709\u4e9b\u66f2\u6298\uff0c\u4f46\u6bcf\u4e00\u6b65\u90fd\u4e0d\u7b97\u767d\u8d70\u3002\n",

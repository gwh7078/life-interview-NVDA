# DGX Spark deployment profile. Copy to deploy/spark/.env (install.sh does this automatically).
DEPLOYMENT_PROFILE=spark
NODE_ENV=production
HOST=127.0.0.1
PORT=4174
DATABASE_PATH=data/memoir.db
AUTH_MODE=demo_phone
AUTH_SESSION_SECRET=

# Shared caches: keep model downloads reusable across reruns.
HF_HOME=$HOME/.cache/huggingface
MODEL_CACHE=$HOME/.cache/huggingface/hub
NGC_CACHE=$HOME/.cache/ngc

# Product realtime remains the same provider ID; only execution backend changes.
STORY_INTERVIEW_PROVIDER=stepaudio2_mini
STORY_INTERVIEW_MODEL=step-audio-2-mini
STEPFUN_REALTIME_MODEL=step-audio-2-mini
STEPAUDIO2_EXECUTION=local
STEPAUDIO2_LOCAL_WS_URL=ws://127.0.0.1:8092/realtime
REALTIME_MEMORY_TRIGGER=supervisor_auto
REALTIME_COACH_GATE_TIMEOUT_MS=2000
REALTIME_COACH_TOTAL_TIMEOUT_MS=6000
REALTIME_SLOW_DEADLINE_MS=5000

# Local Text/Agent model.
TEXT_MODEL_PROVIDER=openai-compatible
TEXT_MODEL_BASE_URL=http://127.0.0.1:8000/v1
TEXT_MODEL_API_FORMAT=chat-completions
TEXT_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
TEXT_MODEL_API_KEY=local-spark
CLOSEOUT_PROVIDER=openai-compatible
CLOSEOUT_BASE_URL=http://127.0.0.1:8000/v1
CLOSEOUT_API_FORMAT=chat-completions
CLOSEOUT_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
STORY_COMPLETION_PROVIDER=openai-compatible
STORY_COMPLETION_BASE_URL=http://127.0.0.1:8000/v1
STORY_COMPLETION_API_FORMAT=chat-completions
STORY_COMPLETION_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
STORY_GENERATION_PROVIDER=openai-compatible
STORY_GENERATION_BASE_URL=http://127.0.0.1:8000/v1
STORY_GENERATION_API_FORMAT=chat-completions
STORY_GENERATION_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4

# Coach keeps the existing qwen3-8b behavior and 2s/6s budgets.
REALTIME_COACH_PROVIDER=openai-compatible
REALTIME_COACH_BASE_URL=http://127.0.0.1:8001/v1
REALTIME_COACH_MODEL=Qwen/Qwen3-8B
REALTIME_COACH_API_KEY=local-spark
REALTIME_COACH_REQUEST_DIALECT=vllm

# Retriever remains derived index. Private transcript and public Era use separate collections.
NEMO_RETRIEVER_ENABLED=true
NEMO_RETRIEVER_BASE_URL=http://127.0.0.1:7670
NEMO_RETRIEVER_VECTORDB_URL=http://127.0.0.1:7671
NEMO_RETRIEVER_COLLECTION=life-interview-transcripts
NEMO_ERA_CONTEXT_ENABLED=true
NEMO_ERA_CONTEXT_COLLECTION=life-interview-era-context-v1

# Formal Agent runtime via NemoClaw/OpenClaw. Backend remains execution authority.
AI_TASK_RUNTIME=agent
NEMOCLAW_SANDBOX=my-assistant
AGENT_PROVIDER=vllm
AGENT_MODEL_DEFAULT=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_MODEL_REASONING=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_MODEL_REASONING_FAST=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_MODEL_REALTIME_CONTEXT=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_MODEL_WRITING=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_RUNTIME_DIAGNOSTICS_PATH=runtime/diagnostics/spark/agent-runtime.jsonl
# Generated locally by install.sh when empty; never commit the generated value.
AGENT_RETRIEVAL_TOKEN_SECRET=
SPARK_AGENT_RETRIEVAL_PORT=4175

# Competition diagnostics. Never capture user content.
DIAGNOSTICS_CAPTURE_CONTENT=0
COMPETITION_TECH_PANEL=1
SPARK_TELEMETRY_PATH=runtime/diagnostics/spark/telemetry.json

# Runtime images/models. Override only after verifying a Spark-compatible release.
SPARK_VLLM_IMAGE=nvcr.io/nvidia/vllm@sha256:9204569b17ee4c0eff75194b8e6e458479c8aee18953b5ab9cf359fcdac659e2
SPARK_TEXT_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
SPARK_TEXT_MAX_MODEL_LEN=32768
SPARK_TEXT_GPU_MEMORY_UTILIZATION=0.40
SPARK_TEXT_MAX_NUM_SEQS=2
SPARK_TEXT_MAX_NUM_BATCHED_TOKENS=4096
SPARK_TEXT_ASYNC_SCHEDULING=false
SPARK_COACH_MODEL=Qwen/Qwen3-8B
SPARK_RETRIEVER_IMAGE=nvcr.io/nvidia/nemo-microservices/nrl-service:26.8.2@sha256:6b93a1f4224387e57c3b0c5241c4a1496c57fd7c2d1f789b9e29db818a9504c1
SPARK_STEPAUDIO_IMAGE=stepfun2025/vllm:step-audio-2-v20250909
SPARK_STEPAUDIO_SOURCE_REF=76e272b56c3917a8d7188f18bbb5a65dfc8a0845
SPARK_STEPAUDIO_HF_MODEL=stepfun-ai/Step-Audio-2-mini

# Credentials are intentionally not committed or auto-persisted by install.sh.
# Export them in the shell, or add them to deploy/spark/.env (chmod 600) when required:
# HF_TOKEN=...
# NGC_API_KEY=...
# NVIDIA_API_KEY=...
